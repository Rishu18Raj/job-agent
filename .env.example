# Gemini via Vertex AI (uses the SAME service account JSON as Google Sheets below --
# just make sure that service account also has the "Vertex AI User" IAM role)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Google Sheets
SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=   # paste full JSON key contents as a single line, or point CI at a file

# Gmail (SMTP via app password)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
NOTIFY_TO=rrishu40@gmail.com

# Safety switch -- keep false until you've manually verified staged applications
AUTO_APPLY_ENABLED=false
